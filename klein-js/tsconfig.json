{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    "stripInternal": true,
    "rootDir": "src/ts",
    "rootDirs": ["src/ts", "build/package"],
    "outDir": "build/package",
    "types": []
  },
  "include": ["src/ts"]
}
